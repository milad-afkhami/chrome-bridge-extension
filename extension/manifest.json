{
  "manifest_version": 3,
  "name": "Chrome Bridge (MCP)",
  "version": "0.3.0",
  "description": "Minimal local bridge: exposes read/exec/snapshot/click/navigate over a localhost WebSocket for Claude Code MCP. Never steals focus.",
  "permissions": ["tabs", "scripting", "alarms", "webRequest", "debugger", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Bridge",
    "default_icon": { "16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png" }
  }
}
